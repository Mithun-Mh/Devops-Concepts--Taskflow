# ==============================================================================
# .env.example — Environment Variable Template
# ==============================================================================
# Copy this file to .env and fill in your real values:
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains real credentials.
# This .env.example file IS safe to commit — it contains only placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE — PostgreSQL connection URL
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
#
# Local development (Docker):
#   DATABASE_URL=postgresql://taskflow_user:taskflow_password@localhost:5432/taskflow_db
#
# Production (example with a managed cloud DB):
#   DATABASE_URL=postgresql://prod_user:S3cret!@prod-db.example.com:5432/taskflow_prod
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://taskflow_user:taskflow_password@localhost:5432/taskflow_db

# ------------------------------------------------------------------------------
# SQL_ECHO — Print every generated SQL statement to stdout
# Set to True only during debugging. Never enable in production.
# ------------------------------------------------------------------------------
SQL_ECHO=False

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_VERSION=0.1.0
ENVIRONMENT=development
